# Project Configuration
PROJECT_NAME="Chatbot API"
VERSION="0.1.0"
HOST="0.0.0.0"
PORT=8000

# Logging Configuration
LOG_LEVEL="INFO"

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# LLM Provider Selection
# "llamacpp" talks to a local llama.cpp server; "openrouter" calls a hosted model.
LLM_PROVIDER="llamacpp"

# OpenRouter Configuration (used when LLM_PROVIDER="openrouter")
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3.5-lightning"
OPENROUTER_TIMEOUT=300
# Optional attribution headers shown on the OpenRouter dashboard.
OPENROUTER_APP_URL=""
OPENROUTER_APP_TITLE=""

# llama.cpp Server Configuration
LLAMA_SERVER_BASE_URL="http://localhost:8080"
LLAMA_SERVER_TIMEOUT=300

# LLM Model Configuration
MODEL="Meta-Llama-3.1-8B-Instruct-Q4_K_M"
MODEL_URL="https://huggingface.co/bartowski/Meta-Llama-3.1-8B-Instruct-GGUF/resolve/main/Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf"
MODEL_REASONING=False
MODEL_REASONING_START_TAG="<think>"
MODEL_REASONING_STOP_TAG="</think>"
MAX_NEW_TOKENS=512

# Retrieval Configuration
# Embedding backend: "sentence-transformers" (runs locally) or "openai" (hosted API).
# OpenRouter proxies chat completions only, so "openai" needs an OpenAI key of its own even when
# the LLM itself is served by OpenRouter.
EMBEDDING_PROVIDER="sentence-transformers"
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# Used only when EMBEDDING_PROVIDER="sentence-transformers".
EMBEDDING_MODEL="jinaai/jina-embeddings-v5-text-small-retrieval"
SYNTHESIS_STRATEGY="tree-summarization"
NUM_RETRIEVALS=2
CHUNK_SIZE=1000
CHUNK_OVERLAP=50
# Minimum relevance score (0 = unrelated, 1 = identical) a chunk needs to reach the prompt.
# The score scale belongs to the embedding model, not the corpus, so this has to move with
# EMBEDDING_MODEL: 0.2 suits all-MiniLM-L6-v2, while a multilingual model scores unrelated text
# well above it. Set a negative value to keep every retrieved chunk.
RETRIEVAL_THRESHOLD=0.2

# Reranking Configuration
# Two-stage retrieval: the dense search returns RERANK_CANDIDATES chunks, a cross-encoder
# reorders them, and NUM_RETRIEVALS survive. Off by default -- it costs a model load at
# startup and a forward pass per query.
RERANK_ENABLED=false
# Measured on tests/retrieval (bge-m3 embeddings, 18 queries): recall@1 88.9% / MRR 0.921,
# against 83.3% / 0.870 unreranked. The 1.1 GB BAAI/bge-reranker-base scored worse (83.3% /
# 0.875) and dropped English recall@3 by 10 points.
# This model is English-only. It also scored 100% on the Chinese queries, but the Chinese
# fixtures contain English technical terms, so it matches shared vocabulary rather than
# reading Chinese. A genuinely non-Latin corpus needs a multilingual reranker
# (BAAI/bge-reranker-v2-m3, jinaai/jina-reranker-v2-base-multilingual) and needs the two
# settings below re-measured with it.
RERANK_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
# Measure this, do not maximise it: widening from 20 to the whole corpus lowered English
# recall@3 from 80% to 70%, because the extra candidates are mostly noise.
RERANK_CANDIDATES=20
# Applied to the reranked score instead of RETRIEVAL_THRESHOLD when reranking is on. Separate
# because the scales differ -- a cross-encoder sigmoid and a cosine relevance score are not
# the same 0.5.
RERANK_THRESHOLD=0.3

# Chat History Configuration
CHAT_HISTORY_LENGTH=2

# WebSocket Configuration
WEBSOCKET_MAX_SIZE=10485760

# File Upload Configuration
ALLOWED_UPLOAD_EXTENSIONS=[".md"]
